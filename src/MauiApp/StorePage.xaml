<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp.StorePage"
             Title="Game Store">

    <Grid RowDefinitions="Auto,* ,Auto" Padding="20" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Game Store" Style="{StaticResource Headline}" />
            <Label x:Name="StoreStatusLabel" Text="Loading products..." />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                <VerticalStackLayout Grid.Row="0" Spacing="8">
                    <Label Text="Available products" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="GameLookupEntry"
                               Grid.Column="0"
                               Placeholder="Look up a game by name or description"
                               TextChanged="OnGameLookupTextChanged"
                               ReturnType="Search"
                               Completed="OnGameLookupCompleted" />
                        <Button x:Name="ClearLookupButton"
                                Grid.Column="1"
                                Text="Clear"
                                Clicked="OnClearLookupClicked"
                                IsEnabled="False" />
                    </Grid>
                    <CollectionView x:Name="ProductsView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 8" Padding="10" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding Description}" />
                                        <VerticalStackLayout Grid.RowSpan="2" Grid.Column="1"
                                                             HorizontalOptions="End" Spacing="6">
                                            <Label Text="{Binding DisplayPrice}"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="End" />
                                            <Button Text="Add to cart"
                                                    Clicked="OnAddToCartClicked"
                                                    CommandParameter="{Binding}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="8">
                    <Label Text="Shopping cart" FontAttributes="Bold" />
                    <CollectionView x:Name="CartView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 8" Padding="10" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{Binding DisplayPrice}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Remove"
                                                Clicked="OnRemoveFromCartClicked"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label x:Name="CartTotalLabel"
                   Grid.Column="0"
                   Text="Total: $0.00"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button x:Name="CheckoutButton"
                    Grid.Column="1"
                    Text="Checkout"
                    Clicked="OnCheckoutClicked"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</ContentPage>
